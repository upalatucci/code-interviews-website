{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/submissions/[linkId]",
      "regex": "^/admin/submissions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPlinkId": "nxtPlinkId"
      },
      "namedRegex": "^/admin/submissions/(?<nxtPlinkId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/auth/[...nextauth]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPnextauth": "nxtPnextauth"
      },
      "namedRegex": "^/api/auth/(?<nxtPnextauth>.+?)(?:/)?$"
    },
    {
      "page": "/api/interview/[token]",
      "regex": "^/api/interview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/api/interview/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/interview/[token]/save",
      "regex": "^/api/interview/([^/]+?)/save(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/api/interview/(?<nxtPtoken>[^/]+?)/save(?:/)?$"
    },
    {
      "page": "/api/interview/[token]/start",
      "regex": "^/api/interview/([^/]+?)/start(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/api/interview/(?<nxtPtoken>[^/]+?)/start(?:/)?$"
    },
    {
      "page": "/api/interview/[token]/submit",
      "regex": "^/api/interview/([^/]+?)/submit(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/api/interview/(?<nxtPtoken>[^/]+?)/submit(?:/)?$"
    },
    {
      "page": "/interview/[token]",
      "regex": "^/interview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/interview/(?<nxtPtoken>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/interviews",
      "regex": "^/admin/interviews(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/interviews(?:/)?$"
    },
    {
      "page": "/admin/links",
      "regex": "^/admin/links(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/links(?:/)?$"
    },
    {
      "page": "/admin/submissions",
      "regex": "^/admin/submissions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/submissions(?:/)?$"
    },
    {
      "page": "/auth/signin",
      "regex": "^/auth/signin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/signin(?:/)?$"
    },
    {
      "page": "/auth/verify-request",
      "regex": "^/auth/verify\\-request(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/verify\\-request(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}