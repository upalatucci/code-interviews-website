# Neon Postgres — auto-injected when you connect a database in Vercel Storage
POSTGRES_URL=

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=

# Resend — for magic-link emails (https://resend.com)
# Not required in development — magic links are printed to the console instead
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@yourdomain.com
